# Local dependencies
/.bundle/
/vendor/bundle/
/node_modules/

# Runtime files and test output
/tmp/*
/log/*
/coverage/
*.tsbuildinfo
npm-debug.log*

# Local environment and Rails encryption keys
/.env*
!/.env.example
/config/master.key
/config/credentials/*.key

# Compiled TypeScript (generated by npm run build)
/public/assessment_export.js
/public/date_picker.js
/public/calendar_dates.js

# Local database files and backups
/db/*.sqlite3*
*.dump
*.sql.gz

# OS and editor files
.DS_Store
._*
/.idea/
*.swp
*.swo
*~
